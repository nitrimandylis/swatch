{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "${m.name}",
  "author": "Nick",
  "themes": [
    {
      "name": "${m.name}",
      "appearance": "${m.variant}",
      "style": {
        "background": "${r.base}",
        "editor.background": "${r.base}",
        "editor.foreground": "${r.text}",
        "editor.line_number": "${r.muted}",
        "editor.active_line_number": "${r.text}",
        "editor.active_line.background": "${r.surface}",
        "editor.gutter.background": "${r.base}",
        "editor.indent_guide": "${a.black[0]}",
        "editor.indent_guide_active": "${r.overlay}",
        "editor.document_highlight.read_background": "${r.overlay}80",

        "text": "${r.text}",
        "text.muted": "${r.muted}",
        "text.placeholder": "${r.muted}",
        "text.accent": "${r.accent}",

        "surface.background": "${r.surface}",
        "elevated_surface.background": "${r.surface}",
        "element.background": "${r.surface}",
        "element.hover": "${r.overlay}",
        "element.selected": "${r.overlay}",
        "ghost_element.hover": "${r.surface}",
        "border": "${a.black[0]}",
        "border.variant": "${r.surface}",
        "border.focused": "${r.overlay}",

        "status_bar.background": "${r.surface}",
        "title_bar.background": "${r.base}",
        "toolbar.background": "${r.base}",
        "tab_bar.background": "${r.base}",
        "tab.active_background": "${r.surface}",
        "tab.inactive_background": "${r.base}",
        "panel.background": "${r.base}",

        "cursor": "${r.accent}",
        "players": [
          { "cursor": "${r.accent}", "background": "${r.accent}", "selection": "${r.overlay}" }
        ],

        "created": "${a.green[1]}",
        "modified": "${a.yellow[0]}",
        "deleted": "${a.red[1]}",
        "error": "${a.red[1]}",
        "warning": "${a.yellow[0]}",
        "info": "${a.blue[1]}",
        "hint": "${r.muted}",

        "terminal.background": "${r.base}",
        "terminal.foreground": "${r.text}",
        "terminal.ansi.black": "${a.black[0]}",
        "terminal.ansi.bright_black": "${a.black[1]}",
        "terminal.ansi.red": "${a.red[0]}",
        "terminal.ansi.bright_red": "${a.red[1]}",
        "terminal.ansi.green": "${a.green[0]}",
        "terminal.ansi.bright_green": "${a.green[1]}",
        "terminal.ansi.yellow": "${a.yellow[0]}",
        "terminal.ansi.bright_yellow": "${a.yellow[1]}",
        "terminal.ansi.blue": "${a.blue[0]}",
        "terminal.ansi.bright_blue": "${a.blue[1]}",
        "terminal.ansi.magenta": "${a.magenta[0]}",
        "terminal.ansi.bright_magenta": "${a.magenta[1]}",
        "terminal.ansi.cyan": "${a.cyan[0]}",
        "terminal.ansi.bright_cyan": "${a.cyan[1]}",
        "terminal.ansi.white": "${a.white[0]}",
        "terminal.ansi.bright_white": "${a.white[1]}",

        "syntax": {
          "comment": { "color": "${r.muted}", "font_style": "italic" },
          "comment.doc": { "color": "${r.muted}", "font_style": "italic" },
          "keyword": { "color": "${r.accent}" },
          "operator": { "color": "${r.muted}" },
          "string": { "color": "${a.green[1]}" },
          "string.escape": { "color": "${a.cyan[1]}" },
          "string.regex": { "color": "${a.cyan[1]}" },
          "string.special": { "color": "${a.cyan[1]}" },
          "number": { "color": "${a.cyan[1]}" },
          "boolean": { "color": "${a.yellow[1]}" },
          "constant": { "color": "${a.cyan[1]}" },
          "function": { "color": "${a.yellow[1]}" },
          "function.method": { "color": "${a.yellow[1]}" },
          "type": { "color": "${a.blue[1]}" },
          "type.builtin": { "color": "${a.blue[1]}" },
          "constructor": { "color": "${a.blue[1]}" },
          "variable": { "color": "${r.text}" },
          "variable.parameter": { "color": "${r.text}", "font_style": "italic" },
          "variable.special": { "color": "${r.accent}", "font_style": "italic" },
          "property": { "color": "${a.blue[1]}" },
          "attribute": { "color": "${a.yellow[0]}" },
          "tag": { "color": "${a.blue[1]}" },
          "label": { "color": "${a.yellow[0]}" },
          "punctuation": { "color": "${r.muted}" },
          "punctuation.bracket": { "color": "${r.muted}" },
          "punctuation.delimiter": { "color": "${r.muted}" },
          "punctuation.special": { "color": "${r.accent}" },
          "emphasis": { "color": "${a.green[1]}", "font_style": "italic" },
          "emphasis.strong": { "color": "${a.yellow[1]}", "font_weight": 700 },
          "title": { "color": "${r.accent}", "font_weight": 700 },
          "link_text": { "color": "${a.cyan[1]}", "font_style": "italic" },
          "link_uri": { "color": "${a.cyan[1]}" },
          "predictive": { "color": "${r.muted}" }
        }
      }
    }
  ]
}

