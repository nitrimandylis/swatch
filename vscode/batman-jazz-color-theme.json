{
  "name": "Batman Jazz",
  "type": "dark",
  "colors": {
    "editor.background": "#09090b",
    "editor.foreground": "#c5d3e0",
    "editorLineNumber.foreground": "#5f7897",
    "editorLineNumber.activeForeground": "#c5d3e0",
    "editorCursor.foreground": "#e85a9c",
    "editor.selectionBackground": "#294a6d",
    "editor.selectionHighlightBackground": "#294a6d80",
    "editor.lineHighlightBackground": "#111319",
    "editorWhitespace.foreground": "#20252f",
    "editorIndentGuide.background1": "#20252f",
    "editorIndentGuide.activeBackground1": "#294a6d",
    "editorBracketMatch.background": "#294a6d",
    "editorBracketMatch.border": "#e85a9c",

    "editorGutter.addedBackground": "#7d9b6f",
    "editorGutter.modifiedBackground": "#4e749e",
    "editorGutter.deletedBackground": "#a23a4a",

    "editorError.foreground": "#c85566",
    "editorWarning.foreground": "#c9a76a",
    "editorInfo.foreground": "#4e749e",

    "sideBar.background": "#09090b",
    "sideBar.foreground": "#c5d3e0",
    "sideBar.border": "#111319",
    "sideBarSectionHeader.background": "#09090b",
    "sideBarTitle.foreground": "#5f7897",
    "list.activeSelectionBackground": "#111319",
    "list.activeSelectionForeground": "#e8eef5",
    "list.hoverBackground": "#111319",
    "list.inactiveSelectionBackground": "#111319",

    "activityBar.background": "#09090b",
    "activityBar.foreground": "#c5d3e0",
    "activityBar.inactiveForeground": "#5f7897",
    "activityBarBadge.background": "#e85a9c",
    "activityBarBadge.foreground": "#09090b",

    "statusBar.background": "#09090b",
    "statusBar.foreground": "#c5d3e0",
    "statusBar.border": "#111319",
    "statusBar.noFolderBackground": "#09090b",
    "statusBar.debuggingBackground": "#e85a9c",
    "statusBar.debuggingForeground": "#09090b",

    "titleBar.activeBackground": "#09090b",
    "titleBar.activeForeground": "#c5d3e0",
    "titleBar.inactiveBackground": "#09090b",
    "titleBar.inactiveForeground": "#5f7897",

    "tab.activeBackground": "#09090b",
    "tab.activeForeground": "#e8eef5",
    "tab.inactiveBackground": "#09090b",
    "tab.inactiveForeground": "#5f7897",
    "tab.activeBorderTop": "#e85a9c",
    "tab.border": "#111319",
    "editorGroupHeader.tabsBackground": "#09090b",
    "editorGroupHeader.tabsBorder": "#111319",

    "panel.background": "#09090b",
    "panelTitle.activeForeground": "#c5d3e0",
    "panelTitle.inactiveForeground": "#5f7897",

    "terminal.background": "#09090b",
    "terminal.foreground": "#c5d3e0",
    "terminal.ansiBlack": "#20252f",
    "terminal.ansiBrightBlack": "#5f7897",
    "terminal.ansiRed": "#a23a4a",
    "terminal.ansiBrightRed": "#c85566",
    "terminal.ansiGreen": "#7d9b6f",
    "terminal.ansiBrightGreen": "#94b586",
    "terminal.ansiYellow": "#c9a76a",
    "terminal.ansiBrightYellow": "#dcc088",
    "terminal.ansiBlue": "#4e749e",
    "terminal.ansiBrightBlue": "#678dae",
    "terminal.ansiMagenta": "#b06a8f",
    "terminal.ansiBrightMagenta": "#e85a9c",
    "terminal.ansiCyan": "#4a8f9e",
    "terminal.ansiBrightCyan": "#67aab8",
    "terminal.ansiWhite": "#c5d3e0",
    "terminal.ansiBrightWhite": "#e8eef5",

    "input.background": "#122031",
    "input.foreground": "#c5d3e0",
    "focusBorder": "#294a6d",
    "widget.shadow": "#00000080",
    "scrollbarSlider.background": "#294a6d80",
    "scrollbarSlider.hoverBackground": "#294a6daa"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5f7897", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#e85a9c" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#5f7897" }
    },
    {
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#94b586" }
    },
    {
      "scope": ["string.regexp"],
      "settings": { "foreground": "#67aab8" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#67aab8" }
    },
    {
      "scope": ["constant.language.boolean", "constant.language.null"],
      "settings": { "foreground": "#dcc088" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": { "foreground": "#dcc088" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"],
      "settings": { "foreground": "#678dae" }
    },
    {
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#c5d3e0" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#c5d3e0", "fontStyle": "italic" }
    },
    {
      "scope": ["variable.language", "variable.language.this"],
      "settings": { "foreground": "#e85a9c", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.tag", "support.type.property-name"],
      "settings": { "foreground": "#678dae" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#c9a76a" }
    },
    {
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#5f7897" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#e85a9c", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#dcc088", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#94b586", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#67aab8", "fontStyle": "underline" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#c85566" }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#8f2a3a", "fontStyle": "strikethrough" }
    }
  ]
}
