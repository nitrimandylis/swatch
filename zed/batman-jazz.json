{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Batman Jazz",
  "author": "Nick",
  "themes": [
    {
      "name": "Batman Jazz",
      "appearance": "dark",
      "style": {
        "background": "#09090b",
        "editor.background": "#09090b",
        "editor.foreground": "#c5d3e0",
        "editor.line_number": "#5f7897",
        "editor.active_line_number": "#c5d3e0",
        "editor.active_line.background": "#122031",
        "editor.gutter.background": "#09090b",
        "editor.indent_guide": "#20252f",
        "editor.indent_guide_active": "#294a6d",
        "editor.document_highlight.read_background": "#294a6d80",

        "text": "#c5d3e0",
        "text.muted": "#5f7897",
        "text.placeholder": "#5f7897",
        "text.accent": "#e85a9c",

        "surface.background": "#122031",
        "elevated_surface.background": "#122031",
        "element.background": "#122031",
        "element.hover": "#294a6d",
        "element.selected": "#294a6d",
        "ghost_element.hover": "#122031",
        "border": "#20252f",
        "border.variant": "#122031",
        "border.focused": "#294a6d",

        "status_bar.background": "#122031",
        "title_bar.background": "#09090b",
        "toolbar.background": "#09090b",
        "tab_bar.background": "#09090b",
        "tab.active_background": "#122031",
        "tab.inactive_background": "#09090b",
        "panel.background": "#09090b",

        "cursor": "#e85a9c",
        "players": [
          { "cursor": "#e85a9c", "background": "#e85a9c", "selection": "#294a6d" }
        ],

        "created": "#94b586",
        "modified": "#c9a76a",
        "deleted": "#c85566",
        "error": "#c85566",
        "warning": "#c9a76a",
        "info": "#678dae",
        "hint": "#5f7897",

        "terminal.background": "#09090b",
        "terminal.foreground": "#c5d3e0",
        "terminal.ansi.black": "#20252f",
        "terminal.ansi.bright_black": "#5f7897",
        "terminal.ansi.red": "#a23a4a",
        "terminal.ansi.bright_red": "#c85566",
        "terminal.ansi.green": "#7d9b6f",
        "terminal.ansi.bright_green": "#94b586",
        "terminal.ansi.yellow": "#c9a76a",
        "terminal.ansi.bright_yellow": "#dcc088",
        "terminal.ansi.blue": "#4e749e",
        "terminal.ansi.bright_blue": "#678dae",
        "terminal.ansi.magenta": "#b06a8f",
        "terminal.ansi.bright_magenta": "#e85a9c",
        "terminal.ansi.cyan": "#4a8f9e",
        "terminal.ansi.bright_cyan": "#67aab8",
        "terminal.ansi.white": "#c5d3e0",
        "terminal.ansi.bright_white": "#e8eef5",

        "syntax": {
          "comment": { "color": "#5f7897", "font_style": "italic" },
          "comment.doc": { "color": "#5f7897", "font_style": "italic" },
          "keyword": { "color": "#e85a9c" },
          "operator": { "color": "#5f7897" },
          "string": { "color": "#94b586" },
          "string.escape": { "color": "#67aab8" },
          "string.regex": { "color": "#67aab8" },
          "string.special": { "color": "#67aab8" },
          "number": { "color": "#67aab8" },
          "boolean": { "color": "#dcc088" },
          "constant": { "color": "#67aab8" },
          "function": { "color": "#dcc088" },
          "function.method": { "color": "#dcc088" },
          "type": { "color": "#678dae" },
          "type.builtin": { "color": "#678dae" },
          "constructor": { "color": "#678dae" },
          "variable": { "color": "#c5d3e0" },
          "variable.parameter": { "color": "#c5d3e0", "font_style": "italic" },
          "variable.special": { "color": "#e85a9c", "font_style": "italic" },
          "property": { "color": "#678dae" },
          "attribute": { "color": "#c9a76a" },
          "tag": { "color": "#678dae" },
          "label": { "color": "#c9a76a" },
          "punctuation": { "color": "#5f7897" },
          "punctuation.bracket": { "color": "#5f7897" },
          "punctuation.delimiter": { "color": "#5f7897" },
          "punctuation.special": { "color": "#e85a9c" },
          "emphasis": { "color": "#94b586", "font_style": "italic" },
          "emphasis.strong": { "color": "#dcc088", "font_weight": 700 },
          "title": { "color": "#e85a9c", "font_weight": 700 },
          "link_text": { "color": "#67aab8", "font_style": "italic" },
          "link_uri": { "color": "#67aab8" },
          "predictive": { "color": "#5f7897" }
        }
      }
    }
  ]
}
